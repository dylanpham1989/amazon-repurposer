# =============================================================================
#  Amazon Product Repurposer — biến môi trường
#  File này KHÔNG được commit (đã có trong .gitignore).
#  Dán key vào các dòng có <<< DÁN VÀO ĐÂY >>>
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BẢO VỆ APP
# -----------------------------------------------------------------------------
# Mật khẩu để đăng nhập vào app. Tự đặt, không phải lấy từ đâu.
APP_PASSWORD=<<< DÁN VÀO ĐÂY: tự đặt 1 mật khẩu >>>

# Khoá ký session cookie. Tao đã sinh sẵn ngẫu nhiên, KHÔNG cần đổi.
SESSION_SECRET=<<< SINH BẰNG: python3 -c "import secrets; print(secrets.token_urlsafe(48))" >>>


# -----------------------------------------------------------------------------
# 2. SCRAPE.DO — lấy HTML Amazon khi bị chặn
#    Lấy ở: https://dashboard.scrape.do  →  mục "API Token"
#    Free: 1.000 request/tháng
# -----------------------------------------------------------------------------
SCRAPEDO_TOKEN=<<< DÁN VÀO ĐÂY >>>


# -----------------------------------------------------------------------------
# 3. GOOGLE GEMINI — viết lại title + mô tả
#    Lấy ở: https://aistudio.google.com/apikey  →  "Create API key"
#    Free: 1.500 request/ngày, 15 request/phút
# -----------------------------------------------------------------------------
GEMINI_API_KEY=<<< DÁN VÀO ĐÂY >>>

# Để nguyên. Alias "-latest" tự trỏ bản Flash mới nhất, không cần sửa khi Google đổi version.
GEMINI_MODEL=gemini-flash-latest


# -----------------------------------------------------------------------------
# 4. CLOUDFLARE R2 — lưu ảnh
#    Free: 10 GB, 1 triệu upload/tháng, egress miễn phí
# -----------------------------------------------------------------------------

# Account ID — Cloudflare Dashboard → R2 → góc phải "Account ID"
# (hoặc lấy từ URL: dash.cloudflare.com/<ĐÂY LÀ ACCOUNT ID>/r2)
R2_ACCOUNT_ID=<<< DÁN VÀO ĐÂY >>>

# API Token — R2 → "Manage R2 API Tokens" → "Create API Token"
#   Permission: Object Read & Write
#   Scope: chỉ chọn bucket của app này (đừng để Apply to all buckets)
# Sau khi tạo, Cloudflare hiện Access Key ID + Secret Access Key MỘT LẦN DUY NHẤT.
R2_ACCESS_KEY_ID=<<< DÁN VÀO ĐÂY >>>
R2_SECRET_ACCESS_KEY=<<< DÁN VÀO ĐÂY >>>

# Tên bucket đã tạo
R2_BUCKET=<<< DÁN VÀO ĐÂY: tên bucket >>>

# URL công khai để xem ảnh. Hai lựa chọn:
#   a) Dev/thử nhanh: bật "Public Development URL" trong Settings của bucket
#      → dạng https://pub-xxxxxxxx.r2.dev   (có rate limit, đủ dùng để test)
#   b) Chạy thật: gắn Custom Domain  → https://cdn.tenmiencuaban.com
# KHÔNG có dấu / ở cuối.
R2_PUBLIC_BASE_URL=<<< DÁN VÀO ĐÂY >>>


# -----------------------------------------------------------------------------
# 5. POSTGRES (Neon) — thay cho SQLite khi deploy
#    Lấy ở: https://console.neon.tech  →  tạo project  →  "Connection string"
#    Chọn bản KHÔNG có "-pooler" cho asyncpg, hoặc giữ pooler cũng được.
#    Free: 0.5 GB, không cần thẻ.
#    Local dev có thể dùng: postgresql://app:app@127.0.0.1:5433/app
# -----------------------------------------------------------------------------
DATABASE_URL=<<< DÁN VÀO ĐÂY >>>


# =============================================================================
#  Phần dưới đã có giá trị mặc định hợp lý — không cần sửa lúc đầu
# =============================================================================

# Thử fetch trực tiếp trước (free vô hạn), chỉ dùng Scrape.do khi bị chặn.
FETCH_DIRECT_FIRST=true

# Giây nghỉ giữa 2 request tới Amazon. ĐỪNG hạ xuống dưới 2 —
# hammer nhanh từ IP nhà là cách nhanh nhất để bị chặn cả IP, mất luôn tầng free.
REQUEST_DELAY_SECONDS=2.0

# Cache HTML đã fetch (giờ). Đây là thứ bảo vệ quota Scrape.do 1.000/tháng.
HTML_CACHE_HOURS=24

MAX_LINKS_PER_BATCH=20
MAX_IMAGES_PER_PRODUCT=12
MAX_IMAGE_BYTES=12000000
